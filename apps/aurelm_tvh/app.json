{
  "id": "aurelm_tvh",
  "title": "TVH",
  "description": "Tvheadend's TV channels on the centre screen: sign in once from the phone (QR code), then Watch, Channel + / -, or the channel list over the picture. The picture shows while parked, the sound plays on the car's speakers. The server transcodes (profiles mgu-hd, mgu-sd, mgu-low: H.264 deinterlaced, AAC) and the profile goes down by itself when the internet is slow. Needs the TVH service.",
  "version": "0.1.5",
  "vendor": "custom",
  "loggingId": "OA9V",
  "iconGlyph": "TV",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_instances": "1",
      "_methods": [
        "connect",
        "disconnect",
        "getListMainConnections"
      ]
    },
    "org.genivi.am.routinginterface.RoutingControlObserver": {
      "_instances": "1",
      "_methods": [
        "hookSourceAvailablityStatusChange"
      ]
    }
  },
  "requires": {
    "aurelm-tvh": "0.1.4"
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "TVH",
      "buttons": [
        [
          "BTN_WATCH",
          "Watch"
        ],
        [
          "BTN_CHUP",
          "Channel +"
        ],
        [
          "BTN_CHDOWN",
          "Channel -"
        ],
        [
          "BTN_STOP",
          "Stop"
        ],
        [
          "BTN_PAGE",
          "TV / Status"
        ],
        [
          "BTN_SIGNIN",
          "Sign in"
        ],
        [
          "BTN_SIGNOUT",
          "Sign out"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "parkedOnly",
      "label": "Picture only while parked (off: also while driving; the driver sees the centre screen)",
      "type": "bool",
      "default": true
    },
    {
      "key": "aspect",
      "label": "Picture shape (also the ASPECT button on the controls)",
      "type": "choice",
      "default": "fit",
      "options": [
        [
          "fit",
          "Fit: the whole picture, black bars"
        ],
        [
          "zoom",
          "Zoom: between"
        ],
        [
          "fill",
          "Fill: the screen full, the edges cut"
        ]
      ]
    },
    {
      "key": "profile",
      "label": "Streaming quality (the server's profile: the most the car asks for)",
      "type": "choice",
      "default": "mgu-hd",
      "options": [
        [
          "mgu-hd",
          "3 Mbit/s (720p, mgu-hd)"
        ],
        [
          "mgu-sd",
          "1.5 Mbit/s (576p, mgu-sd)"
        ],
        [
          "mgu-low",
          "0.7 Mbit/s (mgu-low)"
        ]
      ]
    },
    {
      "key": "adaptive",
      "label": "Lower the quality by itself when the internet is slow",
      "type": "bool",
      "default": true
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    }
  ]
}
