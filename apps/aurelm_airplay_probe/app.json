{
  "id": "aurelm_airplay_probe",
  "title": "AirPlay Test",
  "description": "AirPlay receiver for the head unit, in stages: the network test, and the receiver: the iPhone's screen mirroring on the centre screen while parked (picture only, no sound yet). Needs the AirPlay test service.",
  "version": "0.7.0",
  "vendor": "custom",
  "loggingId": "OA9X",
  "iconGlyph": "AP",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    }
  },
  "requires": {
    "aurelm-airplay-probe": "0.7.0"
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "AirPlay Test",
      "buttons": [
        [
          "BTN_START",
          "Start test"
        ],
        [
          "BTN_RX",
          "Start receiver"
        ],
        [
          "BTN_STOP",
          "Stop"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    }
  ]
}
