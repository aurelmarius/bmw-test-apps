{
  "id": "aurelm_wheel_heat",
  "title": "Wheel Heating",
  "description": "Steering wheel heating on/off from a favourite button: for a heated iDrive 8 (LCI) steering wheel without its own button, fitted to an iDrive 7 car",
  "version": "1.0.3",
  "vendor": "custom",
  "loggingId": "OA9F",
  "iconGlyph": "wheel",
  "signals": {
    "de.bmw.infotainment.climate.climatemaster.ClimateMaster": {
      "statusSteeringWheelHeating": "rsw",
      "statusAvailableSteeringWheelHeating": "rs",
      "_methods": [
        "requestSteeringWheelHeating"
      ],
      "_optional": "switching through the climate service (the voice command's path)"
    },
    "de.bmw.body.steeringwheelcomfort.SteeringWheelClimate": {
      "heatingState": "rs",
      "_methods": [
        "requestHeating"
      ],
      "_optional": "switching through the steering wheel's own service (fallback)"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Wheel Heating",
      "buttons": [
        [
          "BTN_TOGGLE",
          "Heating On / Off"
        ],
        [
          "BTN_PAGE",
          "Details"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "onOpen",
      "label": "When opened from a favourite button",
      "type": "choice",
      "default": "toggle",
      "options": [
        [
          "toggle",
          "Switch heating on / off"
        ],
        [
          "on",
          "Always switch heating on"
        ],
        [
          "show",
          "Only show the status"
        ]
      ]
    },
    {
      "key": "onMenu",
      "label": "When opened from the apps menu",
      "type": "choice",
      "default": "show",
      "options": [
        [
          "show",
          "Only show the status"
        ],
        [
          "toggle",
          "Switch heating on / off"
        ],
        [
          "on",
          "Always switch heating on"
        ]
      ]
    },
    {
      "key": "showOnShortcut",
      "label": "Screen after a favourite button",
      "type": "choice",
      "default": "brief",
      "options": [
        [
          "brief",
          "Show the status, close after 3 s"
        ],
        [
          "show",
          "Show the status screen"
        ],
        [
          "stay",
          "Stay on the current screen"
        ]
      ],
      "reset": 1
    },
    {
      "key": "path",
      "label": "Switch through",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto (climate, then wheel)"
        ],
        [
          "climate",
          "Climate service only"
        ],
        [
          "body",
          "Steering wheel service only"
        ]
      ]
    },
    {
      "key": "clientGroupId",
      "label": "Climate client group",
      "type": "number",
      "default": 0,
      "steps": [
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ]
    },
    {
      "key": "probe",
      "label": "Try other client groups when turned down",
      "type": "bool",
      "default": true
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    }
  ]
}
