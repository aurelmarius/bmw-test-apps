{
  "id": "aurelm_emby",
  "title": "Emby",
  "description": "The head unit as a cast target for the Emby phone app: sign in once from the phone (QR code), then choose \"BMW iDrive\" in Emby's cast menu. The film plays on the centre screen while parked, its sound on the car's speakers; pause, seek and stop from the phone. Needs the Emby cast service.",
  "version": "0.3.12",
  "vendor": "custom",
  "loggingId": "OA9M",
  "iconGlyph": "EM",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_instances": "1",
      "_methods": [
        "connect",
        "disconnect",
        "getListMainConnections"
      ]
    },
    "org.genivi.am.routinginterface.RoutingControlObserver": {
      "_instances": "1",
      "_methods": [
        "hookSourceAvailablityStatusChange"
      ]
    }
  },
  "requires": {
    "aurelm-emby": "0.3.12"
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Emby",
      "buttons": [
        [
          "BTN_SHOW",
          "Show picture"
        ],
        [
          "BTN_STOP",
          "Stop"
        ],
        [
          "BTN_SIGNIN",
          "Sign in"
        ],
        [
          "BTN_SIGNOUT",
          "Sign out"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "parkedOnly",
      "label": "Picture only while parked (off: also while driving; the driver sees the centre screen)",
      "type": "bool",
      "default": true
    },
    {
      "key": "aspect",
      "label": "Picture shape (also the ASPECT button on the controls)",
      "type": "choice",
      "default": "fit",
      "options": [
        [
          "fit",
          "Fit: the whole film, black bars"
        ],
        [
          "zoom",
          "Zoom: between"
        ],
        [
          "fill",
          "Fill: the screen full, the edges cut"
        ]
      ]
    },
    {
      "key": "quality",
      "label": "Streaming quality (the most the car asks the server for)",
      "type": "choice",
      "default": "8",
      "options": [
        [
          "8",
          "8 Mbit/s (1080p)"
        ],
        [
          "4",
          "4 Mbit/s"
        ],
        [
          "2",
          "2 Mbit/s (720p)"
        ],
        [
          "1",
          "1 Mbit/s"
        ]
      ]
    },
    {
      "key": "adaptive",
      "label": "Lower the quality by itself when the internet is slow",
      "type": "bool",
      "default": true
    },
    {
      "key": "cluster",
      "label": "The film on the instrument cluster (a card over the media widget; needs cluster-render from the Store, as Waze on cluster)",
      "type": "bool",
      "default": true
    },
    {
      "key": "clusterX",
      "label": "Cluster card: left / right",
      "type": "choice",
      "default": "0",
      "options": [
        [
          "-160",
          "left 160 px"
        ],
        [
          "-120",
          "left 120 px"
        ],
        [
          "-80",
          "left 80 px"
        ],
        [
          "-40",
          "left 40 px"
        ],
        [
