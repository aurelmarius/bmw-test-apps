{
  "id": "aurelm_emby",
  "title": "Emby",
  "description": "The head unit as a cast target for the Emby phone app: sign in once from the phone (QR code), then choose \"BMW iDrive\" in Emby's cast menu. The film plays on the centre screen while parked, its sound on the car's speakers; pause, seek and stop from the phone. Needs the Emby cast service.",
  "version": "0.3.5",
  "vendor": "custom",
  "loggingId": "OA9M",
  "iconGlyph": "EM",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_instances": "1",
      "_methods": [
        "connect",
        "disconnect",
        "getListMainConnections"
      ]
    },
    "org.genivi.am.routinginterface.RoutingControlObserver": {
      "_instances": "1",
      "_methods": [
        "hookSourceAvailablityStatusChange"
      ]
    }
  },
  "requires": {
    "aurelm-emby": "0.3.5"
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Emby",
      "buttons": [
        [
          "BTN_SHOW",
          "Show picture"
        ],
        [
          "BTN_STOP",
          "Stop"
        ],
        [
          "BTN_SIGNIN",
          "Sign in"
        ],
        [
          "BTN_SIGNOUT",
          "Sign out"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "parkedOnly",
      "label": "Picture only while parked (off: also while driving; the driver sees the centre screen)",
      "type": "bool",
      "default": true
    },
    {
      "key": "aspect",
      "label": "Picture shape (also the ASPECT button on the controls)",
      "type": "choice",
      "default": "fit",
      "options": [
        [
          "fit",
          "Fit: the whole film, black bars"
        ],
        [
          "zoom",
          "Zoom: between"
        ],
        [
          "fill",
          "Fill: the screen full, the edges cut"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    }
  ]
}
