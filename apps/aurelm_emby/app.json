    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
