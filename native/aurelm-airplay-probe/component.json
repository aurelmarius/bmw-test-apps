{
  "id": "aurelm-airplay-probe",
  "kind": "tool",
  "version": "0.8.1",
  "license": "GPL-3.0-or-later",
  "title": "AirPlay network test service",
  "description": "For the app AirPlay Test: the network test, and the AirPlay receiver (UxPlay's protocol on the head unit): the iPhone's screen mirroring decoded on the GPU into mgu-render's frame file, shown by the app while parked, and its sound into SmartXbar's CarLife input. Opens the firewall for its ports only while a test runs.",
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "probe.js",
      "from": "probe.js",
      "mode": "0644"
    },
    {
      "path": "dns.js",
      "from": "dns.js",
      "mode": "0644"
    },
    {
      "path": "airplay.js",
      "from": "airplay.js",
      "mode": "0644"
    },
    {
      "path": "nft.js",
      "from": "nft.js",
      "mode": "0644"
    },
    {
      "path": "receiver.js",
      "from": "receiver.js",
      "mode": "0644"
    },
    {
      "path": "sockgroup.js",
      "from": "sockgroup.js",
      "mode": "0644"
    },
    {
      "path": "check.js",
      "from": "check.js",
      "mode": "0644"
    },
    {
      "path": "cleanup.js",
      "from": "cleanup.js",
      "mode": "0644"
    },
    {
      "path": "README.md",
      "from": "README.md",
      "mode": "0644"
    },
    {
      "path": "uxplay-mgu",
      "from": "../uxplay-mgu/build/uxplay-mgu",
      "mode": "0755"
    },
    {
      "path": "UXPLAY-LICENSE",
      "from": "../uxplay-mgu/build/UXPLAY-LICENSE",
      "mode": "0644"
    },
    {
      "path": "FFMPEG-LICENSE",
      "from": "../uxplay-mgu/build/FFMPEG-LICENSE",
      "mode": "0644"
    }
  ],
  "check": [
    "check.js"
  ],
  "deactivate": [
    "node",
    "cleanup.js"
  ],
  "crashNames": [
    "uxplay-mgu"
  ],
  "units": [
    {
      "name": "aurelm-airplay-probe.socket",
      "from": "systemd/aurelm-airplay-probe.socket"
    },
    {
      "name": "aurelm-airplay-probe.service",
      "from": "systemd/aurelm-airplay-probe.service"
    }
  ],
  "enable": [
    {
      "unit": "aurelm-airplay-probe.socket",
      "target": "sockets.target"
    }
  ],
  "recmgr": [
    "aurelm-airplay-probe"
  ],
  "restart": [
    "aurelm-airplay-probe.service"
  ]
}
