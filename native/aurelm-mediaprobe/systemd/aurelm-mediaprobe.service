[Unit]
Description=aurelm-mediaprobe: what the car offers a music player, for the app Media Probe
RequiresMountsFor=/var/opt
# Started by the app's connection to the socket, never at boot; ends 20 minutes after the app's last request
# with no test on. Ordered before no head-unit unit, waited for by none.
Requires=aurelm-mediaprobe.socket
After=aurelm-mediaprobe.socket
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
# root: SOME/IP to any interface of the catalog (as RideTube's daemon talks to BMW's MediaPlayer), the audio
# manager's routes, and the test tone, which drops to nobody with the sound devices' group itself (tone.js).
# No internet: everything the probe plays is in its package or on 127.0.0.1.
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=-/bin/sh -c 'mkdir -p /var/opt/aurelm-mediaprobe/state /var/opt/aurelm-mediaprobe/play && chmod 0700 /var/opt/aurelm-mediaprobe/state && chmod 0711 /var/opt/aurelm-mediaprobe/play'
ExecStart=/usr/bin/node /var/opt/aurelm-mediaprobe/current/service.js
ExecStopPost=-/usr/bin/node /var/opt/aurelm-mediaprobe/current/cleanup.js
Restart=on-failure
RestartSec=10
# whatever the tests changed is undone as it ends (6 s at most)
TimeoutStopSec=8
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryLimit=192M
TasksMax=24
# No core dump goes to the crash handler (which restarts the head unit for a program it does not list),
# so a crash restarts this service and never the head unit.
LimitCORE=1
StandardOutput=journal
StandardError=journal
