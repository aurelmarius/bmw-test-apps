# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=aurelm-mediaprobe control socket (the app Media Probe)

[Socket]
# The app's connection starts aurelm-mediaprobe.service; nothing of it runs before, at boot included. Root's alone
# when made; sockgroup.js then gives it the Media Probe app's own group (0660), not tm_oap_app, which every app
# has. The socket file goes when the socket stops (an uninstall).
ListenStream=/run/aurelm-mediaprobe.sock
SocketMode=0600
RemoveOnStop=yes
ExecStartPost=-/bin/sh -c 'ulimit -c 1; exec /usr/bin/node /var/opt/aurelm-mediaprobe/current/sockgroup.js'
# no core dump from the command above to the crash handler
LimitCORE=1

[Install]
WantedBy=sockets.target
