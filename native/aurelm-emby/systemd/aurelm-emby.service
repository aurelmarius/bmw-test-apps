[Unit]
Description=aurelm-emby: the head unit as an Emby cast target, for the app Emby
RequiresMountsFor=/var/opt
# Started by the app's connection to the socket, never at boot. Signed in, it stays until the unit sleeps
# (so the Emby app can cast to it); signed out, it ends 10 minutes after the last request. Ordered before
# no head-unit unit, waited for by none.
Requires=aurelm-emby.socket
After=aurelm-emby.socket
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
# root: the sign-in page opens (and closes again) an accept rule for its port in the unit's firewall (nft).
# The Emby client itself runs as the tool's internet uid (13101), a child of this service with its limits.
# No "+" commands: every command here runs with the limits below, LimitCORE=1 included.
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=EMBY_STATE=/var/opt/aurelm-emby/state
ExecStartPre=-/bin/sh -c 'mkdir -p /var/opt/aurelm-emby/state && chmod 0700 /var/opt/aurelm-emby/state'
ExecStart=/usr/bin/node /var/opt/aurelm-emby/current/service.js
# however the service ended (stop, crash, kill, the out-of-memory killer): the firewall as it was
ExecStopPost=-/usr/bin/node /var/opt/aurelm-emby/current/cleanup.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=8
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryLimit=128M
TasksMax=32
# No core dump goes to the crash handler (which restarts the head unit for a program it does not list),
# so a crash restarts this service and never the head unit.
LimitCORE=1
StandardOutput=journal
StandardError=journal
